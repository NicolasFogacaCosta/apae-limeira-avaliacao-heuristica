{#
  Documento comum às páginas geradas por modelo (notícias e listagens).
  Dados esperados: tituloPagina (texto do <title>) e classeBody.
#}
{% set raiz = page.url | raiz %}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ tituloPagina }} – APAE Limeira</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Engagement&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Roboto:wght@400;500;700&family=Rubik:wght@300;400&family=Sansita:wght@400;700&display=swap">
<link rel="stylesheet" href="{{ raiz }}assets/css/estilo.css">
</head>
<body class="{{ classeBody }}">
{% include "partes/cabecalho.njk" %}
{{ content | safe }}
{% include "partes/rodape.njk" %}
<script src="{{ raiz }}assets/js/principal.js"></script>
</body>
</html>
